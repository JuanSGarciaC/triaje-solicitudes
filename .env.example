# Copia este archivo como backend/.env y ajusta los valores.
LLM_PROVIDER=mock
# Proveedores: mock (sin costo) | gemini (Google AI Studio) | anthropic
# Para Gemini: LLM_PROVIDER=gemini y pega tu clave de https://aistudio.google.com/apikey
# (nunca subas este archivo a GitHub)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
CONFIDENCE_THRESHOLD=0.75
ALWAYS_REVIEW_PRIORITIES=alta
CORS_ORIGINS=http://localhost:5173
# Demo pública (ver README): solo ejemplos ya escritos, límite por IP y tope de filas.
DEMO_MODE=false

# Marca visible en el panel y en /como-funciona (opcional)
# BRAND_NAME=Sello
# BRAND_TAGLINE=triaje de solicitudes de TI

# Plazos por prioridad (horas) y equipo por categoría (opcionales)
# SLA_HOURS=alta=4,media=24,baja=72
# TEAM_ROUTES=acceso_cuentas=Accesos,hardware=Equipos,software=Software,red_conectividad=Redes,nuevo_servicio=Servicios,otro=Mesa general
# Avisos: webhook saliente firmado con HMAC-SHA256 (sin URL quedan como «simulado»)
# NOTIFY_URL=https://tu-receptor.example/avisos
# NOTIFY_SECRET=cambia-esto
