# Copia este archivo como backend/.env y ajusta los valores.
LLM_PROVIDER=mock
# Proveedores: mock (sin costo) | gemini (Google AI Studio) | anthropic
# Para Gemini: LLM_PROVIDER=gemini y pega tu clave de https://aistudio.google.com/apikey
# (nunca subas este archivo a GitHub)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
CONFIDENCE_THRESHOLD=0.75
ALWAYS_REVIEW_PRIORITIES=alta
CORS_ORIGINS=http://localhost:5173
